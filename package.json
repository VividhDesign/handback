{
  "name": "handback",
  "version": "0.1.0",
  "private": true,
  "description": "An AI return desk for rental deposits, built on PayPal authorization holds.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "session": "node scripts/approval-session.ts",
    "samples": "node scripts/prepare-samples.ts",
    "check-secrets": "bash scripts/check-secrets.sh",
    "export-seed": "node scripts/export-seed.ts"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "@paypal/agent-toolkit": "^1.11.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bryntum/scheduler": "npm:@bryntum/scheduler-trial@^7.3.8",
    "@bryntum/scheduler-react": "^7.3.8",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ag-studio-react": "^3.1.0",
    "concurrently": "^10.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
