# Copy to ../secrets.env (outside the repo) for local runs. On Render, set these as env vars.
# The server refuses to start unless PAYPAL_ENV=sandbox.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: reuse an existing webhook instead of registering one on boot.
PAYPAL_WEBHOOK_ID=

GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Optional sponsor tools
CHANNEL3_API_KEY=
AG_STUDIO=

# Public https URL (Render sets RENDER_EXTERNAL_URL itself).
PUBLIC_BASE_URL=
DATA_DIR=data
PORT=8787
ADMIN_TOKEN=
AI_DAILY_CAP_GLOBAL=150
AI_MIN_INTERVAL_MS=7000
AUTO_RELEASE_MIN_CONF=0.85
